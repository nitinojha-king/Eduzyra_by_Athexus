
# ─────────────────────────────────────────────────────────────────────────────
# Eduzyra Backend — Environment Template
#
# Setup:
#   cp .env.example .env        # Linux / macOS
#   Copy-Item .env.example .env # Windows PowerShell
#
# Rules:
#   - NEVER commit `.env` — only this `.env.example` file is tracked by git.
#   - Fill in the empty values below with your own local / production secrets.
#   - Use TEST keys in development, LIVE keys in production.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ─────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# Options: development | production | test
LOG_LEVEL=debug
# Options: debug (dev) | info (prod). Overrides default per NODE_ENV if set.

# ── Frontend / CORS ────────────────────────────────────────────────────────
# Comma-separate multiple origins in production (e.g., https://eduzyra.com,https://www.eduzyra.com)
CLIENT_ORIGIN=http://localhost:5173
# Public backend URL (used for webhooks, callbacks, absolute links).
# Example prod: https://api.eduzyra.com
BACKEND_PUBLIC_URL=http://localhost:5000

# ── Database ───────────────────────────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/eduzyra

# ── Auth (JWT) ─────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Cookie signing secret (required if using signed cookies).
COOKIE_SECRET=change_this_to_another_long_random_string

# ── Password reset + login lockout ─────────────────────────────────────────
RESET_TOKEN_TTL_MINUTES=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# ── Signup email verification (OTP) ─────────────────────────────────────
OTP_TTL_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=45
OTP_MAX_ATTEMPTS=5

# ── Razorpay (Payments) ──────────────────────────────────────────────────
# Get these from https://dashboard.razorpay.com/app/keys
# Use TEST keys for development (rzp_test_*) and LIVE keys for production (rzp_live_*).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Webhook secret — set this in the Razorpay Dashboard under:
#   Settings → Webhooks → Create Webhook
# Point the webhook URL to:  https://yourdomain.com/api/payments/webhook
# Subscribe to events: payment.captured, payment.failed, refund.processed
# Copy the "Secret" shown after creation into RAZORPAY_WEBHOOK_SECRET below.
RAZORPAY_WEBHOOK_SECRET=

# Payment currency (must match values allowed in src/models/Order.js)
CURRENCY=INR

# ── Email (SMTP) ─────────────────────────────────────────────────────────
# Supports Gmail App Password OR Brevo SMTP — both use the same env vars.
#
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com, SMTP_PASS=app-password
#   (Generate an App Password at https://myaccount.google.com/apppasswords)
# Brevo: SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587, SMTP_USER=your@email, SMTP_PASS=brevo-key
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_NAME=Eduzyra
EMAIL_FROM_ADDRESS=noreply@eduzyra.dev
# Admin inbox for contact-form submissions. Defaults to EMAIL_FROM_ADDRESS if unset.
ADMIN_EMAIL=

# ── Cloudinary (File Uploads) ────────────────────────────────────────────
# Get these from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=eduzyra

# ── Production hardening (optional) ──────────────────────────────────────
# Rate limiting (requests per window, per route group). Unset = app defaults.
# RATE_LIMIT_AUTH_MAX=20
# RATE_LIMIT_API_MAX=100
# Shared store for PM2 cluster mode (express-rate-limit MemoryStore is per-process).
# Set this in production when using `instances: max` in ecosystem.config.cjs.
# REDIS_URL=
# Error tracking (e.g., Sentry). Unset = console/Winston only.
# SENTRY_DSN=
